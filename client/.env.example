# MundaLink client — copy to .env and fill in real values. Never commit .env.
# Live backend origin (no trailing slash). Leave empty to use demonstration data.
VITE_API_BASE_URL=http://localhost:5000
# Set to 'true' to force demonstration data even when a backend URL is set.
VITE_USE_MOCK_API=false
# Firebase web config (public client keys — safe for the browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
