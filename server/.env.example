# MundaLink backend — placeholder environment template.
# Copy to .env and fill in real values. Never commit the real .env.

# --- Application ---
PORT=5000
NODE_ENV=development

# --- Frontend CORS origin (must match the deployed Vite app) ---
CLIENT_URL=http://localhost:5173

# --- Database (Supabase PostgreSQL) ---
# Prisma 6 uses DATABASE_URL for pooled connections and DIRECT_URL for direct connections.
# Paste values from the Supabase dashboard (Project Settings -> Database). Never commit real values.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-DB-HOST]:5432/postgres"

# --- Firebase ---
# Path to the service-account JSON downloaded from the Firebase console.
# The file itself must stay out of git (see .gitignore).
FIREBASE_SERVICE_ACCOUNT_PATH="./secrets/firebase-service-account.json"

# --- OpenTelemetry / metrics (optional) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
