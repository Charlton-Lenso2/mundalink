# --- Database (Supabase PostgreSQL) ---
# Prisma 6 uses DATABASE_URL for the connection pool and DIRECT_URL for raw connections.
# Use the pooled URL for prisma generate/migrate; use DIRECT_URL for schema push tests.
DATABASE_URL="postgresql://postgres:munkalab:password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:munkalab:password@db.mzkyszlnggqlsxctufdw.supabase.co:5432/postgres"

# --- Firebase ---
FIREBASE_SERVICE_ACCOUNT_PATH="./secrets/mundalink-e067c-firebase-adminsdk-fbsvc-48ef0ddf2c.json"

