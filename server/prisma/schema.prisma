// MundaLink — Prisma schema (Supabase PostgreSQL, NUMERIC(20,6) for money/quantity).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id          String    @id @default(cuid())
  firebaseUid String    @unique @db.VarChar(255)
  displayName String?
  email       String?
  phone       String?
  avatarUrl   String?

  city      String?
  region    String?
  country   String? @default("Zimbabwe")
  latitude  Float?
  longitude Float?

  role        String    @default("OBSERVER") @db.VarChar(32)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  listings    Listing[]
  offers      Offer[]
  dealsBought AgreedDeal[] @relation("DealBuyer")
  dealsSold   AgreedDeal[] @relation("DealSeller")

  @@map("profiles")
}

model Listing {
  id          String    @id @default(cuid())
  sellerId    String
  seller      Profile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title       String    @db.Text
  description String?   @db.Text

  category    String?   @db.VarChar(128)
  commodity   String?   @db.VarChar(128)
  quantity    Decimal   @db.Decimal(20, 6)
  unit        String?   @db.VarChar(32)

  pricePerUnit Decimal   @db.Decimal(20, 6)
  currency     String    @default("USD") @db.VarChar(3)

  location    String?
  latitude    Float?
  longitude   Float?

  status      String    @default("DRAFT") @db.VarChar(16)
  availableQuantity Decimal @db.Decimal(20, 6)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  offers      Offer[]
  deals       AgreedDeal[]
  inventory   Inventory?

  @@index([status])
  @@index([category])
  @@index([sellerId])
  @@index([location])
  @@index([latitude, longitude])
  @@index([createdAt])

  @@map("listings")
}

model Offer {
  id          String    @id @default(cuid())
  buyerId     String
  buyer       Profile   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  offeredQuantity Decimal @db.Decimal(20, 6)
  offeredPrice    Decimal @db.Decimal(20, 6)
  message         String?

  status      String    @default("PENDING") @db.VarChar(16)
  expiresAt   DateTime?

  deal        AgreedDeal? @relation("DealOffer")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([listingId, buyerId])
  @@index([listingId])
  @@index([status])
  @@index([buyerId])
  @@index([createdAt])

  @@map("offers")
}

model AgreedDeal {
  id          String    @id @default(cuid())
  offerId     String    @unique
  offer       Offer     @relation("DealOffer", fields: [offerId], references: [id], onDelete: Restrict)
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  agreedQuantity Decimal  @db.Decimal(20, 6)
  agreedPrice    Decimal  @db.Decimal(20, 6)

  status      String    @default("PENDING") @db.VarChar(16)

  buyerId     String
  buyer       Profile   @relation("DealBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      Profile   @relation("DealSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  executedAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([createdAt])

  @@map("agreed_deals")
}

model Inventory {
  id              String    @id @default(cuid())
  listingId       String    @unique
  listing         Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  availableQuantity Decimal @db.Decimal(20, 6)

  entityId        String?
  entityType      String?   @db.VarChar(32)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("inventory")
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String?   @db.VarChar(255)
  actorType  String?   @db.VarChar(32)

  entityType String
  entityId   String

  action     String    @db.VarChar(32)
  payload    String?   @db.Text

  createdAt  DateTime  @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([actorId])
  @@index([createdAt])

  @@map("audit_logs")
}
