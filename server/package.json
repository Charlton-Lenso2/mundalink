{
  "name": "mundalink-server",
  "version": "1.0.0",
  "description": "MundaLink backend: agricultural commerce & transaction-coordination API.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "decimal.js": "^10.5.0",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/shelljs": "^0.8.15",
    "@types/supertest": "^6.0.3",
    "shelljs": "^0.8.5",
    "supertest": "^7.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
